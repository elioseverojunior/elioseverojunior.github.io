# Hand-maintained career data. These files are written as aligned columnar
# tables — one skill or role per line, fields lined up — because they are read
# and edited as tables. Prettier reflows every one of those lines into a
# multi-line flow map, which parses identically and is materially harder to
# scan or diff. The alignment is the point, so the formatter stays out.
data/

# Files Prettier has no parser for (no plugin loaded)
.gitignore
.nvmrc
.npmrc
.prettierignore
*.toml

# Changeset internal cache (the .md changeset entries are still formatted)
.changeset/.cache/

# Rumdl cache
.rumdl_cache/

# Local claude-mem scratch buffer — gitignored, not project source.
# ESLint (`ignores`) and rumdl (`exclude`) already skip it.
.remember/
